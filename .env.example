# ============================================================
# Born to Run — Exemplo de variáveis de ambiente
# ------------------------------------------------------------
# Copie este arquivo para .env.local e preencha com os valores
# reais do seu projeto Supabase. NÃO faça commit do .env.local.
#   cp .env.example .env.local
# ============================================================

# URL do projeto Supabase (pública)
# Encontrada em: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave anônima pública (anon/public key) do Supabase
# Encontrada em: Supabase Dashboard > Project Settings > API > Project API keys > anon public
# Observação: esta chave é pública por natureza. A segurança real vem das políticas de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui

# ------------------------------------------------------------
# NÃO adicione a service_role key com prefixo NEXT_PUBLIC_.
# A service_role NUNCA deve ser exposta no cliente nem versionada.
# Use-a apenas em código de servidor confiável, se algum dia
# for necessária (ex.: excluir usuários em auth.users).
# ------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=defina_apenas_no_servidor_seguro_nunca_no_cliente
